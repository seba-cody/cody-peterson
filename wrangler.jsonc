// A bare `wrangler deploy` from a clean checkout (the Cloudflare Git build)
// reads this file: it runs the release gate and the Astro build, then uploads
// the built Worker. Astro itself builds from wrangler.astro.jsonc; keep the
// bindings, flags and dates of the two files the same. After any build,
// `wrangler deploy` uses the generated dist/server/wrangler.json instead, so
// release with `npm run deploy`, which always runs the gate first.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cody-peterson",
  "compatibility_date": "2026-04-10",
  "observability": {
    "enabled": true
  },
  "main": "dist/server/entry.mjs",
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "build": {
    "command": "node scripts/build-release.mjs"
  },
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "send_email": [
    {
      "name": "ORDER_MAIL"
    }
  ]
}
