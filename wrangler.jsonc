{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cody-peterson",
  "compatibility_date": "2026-04-10",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "build": {
    "command": "node scripts/build-release.mjs"
  },
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "send_email": [
    {
      "name": "ORDER_MAIL"
    }
  ]
}
