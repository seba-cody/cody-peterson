---
import Base from '../layouts/Base.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Media — Cody Peterson',
  description: 'Podcast appearances, interviews, and press coverage featuring Cody Peterson on depth psychology, addiction, and the archetype of the Alcoholic.',
  url: 'https://www.cody-peterson.com/media/',
  mainEntity: { '@id': 'https://www.cody-peterson.com/#person' },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.cody-peterson.com/' },
    { '@type': 'ListItem', position: 2, name: 'Media', item: 'https://www.cody-peterson.com/media/' },
  ],
};
---
<Base
  title="Media"
  description="Podcast appearances, interviews, and press coverage featuring Cody Peterson on depth psychology, addiction, and the archetype of the Alcoholic."
  jsonLd={[jsonLd, breadcrumb]}
>

  <div class="page-header">
    <div class="page-header-inner">
      <div class="folio">
        <span>No. III &nbsp;·&nbsp; In the Press</span>
        <em>Interviews, podcasts &amp; lectures</em>
      </div>
      <h1><em>Media</em></h1>
      <p class="subtitle">Interviews, podcast appearances, and press for <em>The Shadow of a Figure of Light</em> and Seba.Health.</p>
    </div>
  </div>

  <section class="section">
    <div class="section-inner">
      <header class="section-header">
        <span class="eyebrow">I. &nbsp; Interviews &amp; Features</span>
        <h2>Long-form conversations</h2>
      </header>
      <div class="media-item">
        <h3><a href="https://inmag.com/books/shadow-of-a-figure-the-alcoholic-journey-to-enlightenment-cody-peterson.html" target="_blank" rel="noopener">Beyond a Shadow of a Doubt</a></h3>
        <p>INmag &mdash; full interview on the book and the archetype of the Alcoholic.</p>
      </div>
      <div class="media-item">
        <h3><a href="https://player.fm/series/aeon-byte-gnostic-radio-1335182/cody-peterson-on-cg-jung-and-addiction" target="_blank" rel="noopener">C.G. Jung and Addiction</a></h3>
        <p>Aeon Byte Gnostic Radio &mdash; Jung, addiction, and the spiritual dimensions of recovery.</p>
      </div>
    </div>
  </section>

  <section class="section section-alt reveal">
    <div class="section-inner">
      <header class="section-header">
        <span class="eyebrow">II. &nbsp; Podcast Appearances</span>
        <h2>On the record</h2>
      </header>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=Q8hG0TMgM90" target="_blank" rel="noopener">From Addiction to Spiritual Awakening</a></h3>
        <p>Positive Talk Radio</p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=IM8syhL5t7c" target="_blank" rel="noopener">Sobriety &amp; Spirituality</a></h3>
        <p>A Trauma Survivor Thriver&rsquo;s Podcast &mdash; with Lorilee Binstock</p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=pArdMFdT6IY" target="_blank" rel="noopener">The Archetype of the Alcoholic &amp; Spiritual Awakening</a></h3>
        <p>Sober Voyager Podcast</p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=XurWfWR3j7A" target="_blank" rel="noopener">Author/Recovering Alcoholic Cody Peterson Interview</a></h3>
        <p>The Mike Wagner Show</p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=mppJKZ-DmD0" target="_blank" rel="noopener">The Archetype of the Alcoholic</a></h3>
        <p>Interview with Daniel T. Bourne</p>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="section-inner">
      <header class="section-header">
        <span class="eyebrow">III. &nbsp; Academic &amp; Teaching</span>
        <h2>Scholarship &amp; lectures</h2>
      </header>
      <div class="media-item">
        <h3><a href="https://www.tandfonline.com/doi/full/10.1080/19342039.2025.2487105" target="_blank" rel="noopener">Taming Wild Beasts</a></h3>
        <p>Published in <em>Jung Journal: Culture &amp; Psyche</em>, Vol. 19, Issue 2 &mdash; 2025.</p>
      </div>
      <div class="media-item">
        <h3>Presentations at the C.G. Jung Institute, Zurich</h3>
        <p>Lectures on depth psychology and the archetype of the Alcoholic.</p>
      </div>
      <div class="media-item">
        <h3>Dreamwork &mdash; Dreams and Symbols of Recovery</h3>
        <p>Four-part workshop series for Friendly Circle Berlin, April 2025. <a href="/videos/">Watch the videos &rarr;</a></p>
      </div>
    </div>
  </section>

</Base>
