---
import Base from '../layouts/Base.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Media — Cody Peterson',
  description: 'Podcast appearances, interviews, and press coverage featuring Cody Peterson on depth psychology, addiction, and the archetype of the Alcoholic.',
  url: 'https://www.cody-peterson.com/media/',
  mainEntity: { '@id': 'https://www.cody-peterson.com/#person' },
};

const bearPsychologyEpisode = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: 'Addiction and the Journey to Enlightenment',
  datePublished: '2026-05-01',
  url: 'https://bearpsychology.ca/addiction-and-the-journey-to-enlightenment/',
  associatedMedia: [
    'https://youtu.be/uOQRBeLSLQ8?si=AX06IzfLxrxDOJXn',
    'https://directory.libsyn.com/episode/index/id/41078220',
    'https://podcasts.apple.com/us/podcast/addition-and-the-journey-to-enlightenment/id1463793962?i=1000764900166',
    'https://open.spotify.com/show/6RGGInXwRDux3YvVQGT3p7',
  ],
  about: [
    'Depth psychology',
    'Addiction recovery',
    'The Shadow of a Figure of Light',
    'Spiritual transformation',
  ],
  guest: { '@id': 'https://www.cody-peterson.com/#person' },
  partOfSeries: {
    '@type': 'PodcastSeries',
    name: 'Bear Psychology Radio Show',
    url: 'https://bearpsychology.ca/',
  },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.cody-peterson.com/' },
    { '@type': 'ListItem', position: 2, name: 'Media', item: 'https://www.cody-peterson.com/media/' },
  ],
};
---
<Base
  title="Media"
  description="Podcast appearances, interviews, and press coverage featuring Cody Peterson on depth psychology, addiction, and the archetype of the Alcoholic."
  jsonLd={[jsonLd, bearPsychologyEpisode, breadcrumb]}
>

  <div class="page-header">
    <div class="page-header-inner">
      <h1>Media</h1>
      <p class="subtitle">Interviews, podcast appearances, and press for <em>The Shadow of a Figure of Light</em> and Seba.Health.</p>
    </div>
  </div>

  <section class="section">
    <div class="section-inner">
      <header class="section-header">
        <span class="eyebrow">I. &nbsp; Interviews &amp; Features</span>
        <h2>Long-form conversations</h2>
      </header>
      <div class="media-item">
        <h3><a href="https://inmag.com/books/shadow-of-a-figure-the-alcoholic-journey-to-enlightenment-cody-peterson.html" target="_blank" rel="noopener">Beyond a Shadow of a Doubt</a></h3>
        <p>INmag &mdash; full interview on the book and the archetype of the Alcoholic.</p>
      </div>
      <div class="media-item">
        <h3><a href="https://player.fm/series/aeon-byte-gnostic-radio-1335182/cody-peterson-on-cg-jung-and-addiction" target="_blank" rel="noopener">C.G. Jung and Addiction</a></h3>
        <p>Aeon Byte Gnostic Radio &mdash; Jung, addiction, and the spiritual dimensions of recovery.</p>
      </div>
    </div>
  </section>

  <section class="section section-alt reveal">
    <div class="section-inner">
      <header class="section-header">
        <span class="eyebrow">II. &nbsp; Podcast Appearances</span>
        <h2>On the record</h2>
      </header>
      <div class="media-item media-item-featured">
        <h3><a href="https://bearpsychology.ca/addiction-and-the-journey-to-enlightenment/" target="_blank" rel="noopener">Addiction and the Journey to Enlightenment</a></h3>
        <p>
          Bear Psychology Radio Show &mdash; with Dr. Anna Baranowsky, on
          <em>The Shadow of a Figure of Light</em>, the archetypal underpinnings of experience,
          and the path from addiction toward transformation, healing, and freedom.
          <span class="media-links">
            <a href="https://youtu.be/uOQRBeLSLQ8?si=AX06IzfLxrxDOJXn" target="_blank" rel="noopener">YouTube</a>
            <a href="https://directory.libsyn.com/episode/index/id/41078220" target="_blank" rel="noopener">Libsyn</a>
            <a href="https://podcasts.apple.com/us/podcast/addition-and-the-journey-to-enlightenment/id1463793962?i=1000764900166" target="_blank" rel="noopener">Apple Podcasts</a>
            <a href="https://open.spotify.com/show/6RGGInXwRDux3YvVQGT3p7" target="_blank" rel="noopener">Spotify</a>
          </span>
        </p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=Q8hG0TMgM90" target="_blank" rel="noopener">From Addiction to Spiritual Awakening</a></h3>
        <p>Positive Talk Radio</p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=IM8syhL5t7c" target="_blank" rel="noopener">Sobriety &amp; Spirituality</a></h3>
        <p>A Trauma Survivor Thriver&rsquo;s Podcast &mdash; with Lorilee Binstock</p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=pArdMFdT6IY" target="_blank" rel="noopener">The Archetype of the Alcoholic &amp; Spiritual Awakening</a></h3>
        <p>Sober Voyager Podcast</p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=XurWfWR3j7A" target="_blank" rel="noopener">Author/Recovering Alcoholic Cody Peterson Interview</a></h3>
        <p>The Mike Wagner Show</p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.youtube.com/watch?v=mppJKZ-DmD0" target="_blank" rel="noopener">The Archetype of the Alcoholic</a></h3>
        <p>Interview with Daniel T. Bourne</p>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="section-inner">
      <header class="section-header">
        <span class="eyebrow">III. &nbsp; Academic &amp; Teaching</span>
        <h2>Scholarship &amp; lectures</h2>
        <p><a href="/research/#publications">View the full publication record</a>.</p>
      </header>
      <div class="media-item">
        <h3><a href="https://doi.org/10.1080/19342039.2026.2670265" target="_blank" rel="noopener">The Iron Thūmos and the Empty Vessel: A Homeric Response to “Answer to Job”</a></h3>
        <p>Published in <em>Jung Journal: Culture &amp; Psyche</em>, Vol. 20, Issue 3 &mdash; September 2026. Open access. <a href="/iron-thumos/">About the essay</a>.</p>
      </div>
      <div class="media-item">
        <h3><a href="https://www.tandfonline.com/doi/full/10.1080/19342039.2025.2487105" target="_blank" rel="noopener">Taming Wild Beasts</a></h3>
        <p>Published in <em>Jung Journal: Culture &amp; Psyche</em>, Vol. 19, Issue 2 &mdash; 2025.</p>
      </div>
      <div class="media-item">
        <h3>Presentations at the C.G. Jung Institute, Zurich</h3>
        <p>Lectures on depth psychology and the archetype of the Alcoholic.</p>
      </div>
      <div class="media-item">
        <h3>Dreamwork &mdash; Dreams and Symbols of Recovery</h3>
        <p>Four-part workshop series for Friendly Circle Berlin, April 2025. <a href="/videos/">Watch the videos</a></p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="section-inner research-intro">
      <div><span class="eyebrow">Invitations &amp; correspondence</span><h2>Continue the conversation.</h2></div>
      <div class="prose"><p>For interviews, lectures, seminars, and research correspondence, write to <a href="mailto:cody@seba.health">cody@seba.health</a>.</p><p>A short biography and the longer story are on the <a href="/about/">About page</a>. Current research, methods, and publications are collected under <a href="/research/">Research</a>.</p></div>
    </div>
  </section>
</Base>
