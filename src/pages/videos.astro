---
import Base from '../layouts/Base.astro';

const series = [
  {
    title: 'Dreamwork: Dreams and Symbols of Recovery',
    description: 'A four-part series presented for Friendly Circle Berlin, April 2025.',
    videos: [
      { title: 'Alchemical Symbolism and Modern Dreams', description: 'Dream interpretation through the lens of Jung\'s contributions to alchemy.', youtube_id: 'EzDFZsEOMVQ', uploadDate: '2025-04-02' },
      { title: 'The Divine Feminine', description: 'The Gnostic figure of Sophia, the divine feminine trapped in matter, and the modern masculine psyche.', youtube_id: 'TvrcDw0CB8I', uploadDate: '2025-04-09' },
      { title: 'Mercurius', description: 'The alchemical Mercurius as duplex character — Trickster, Alcoholic, and bridge to the anima.', youtube_id: 'tqZl1kvvZSM', uploadDate: '2025-04-17' },
      { title: 'The Philosopher\'s Stone', description: 'Squaring the circle, the four functions, and the mythological context for the coniunctio.', youtube_id: 'P9D_28CEAqs', uploadDate: '2025-04-23' },
    ],
  },
  {
    title: 'The Archetype of the Alcoholic',
    description: 'Seminars on the archetype, the coniunctio, and the Twelve Steps as doorways to the Self.',
    videos: [
      { title: 'The Mystery of the Coniunctio', description: 'Jung\'s Spiritus Contra Spiritum and the coniunctio oppositorum through the lens of the Alcoholic.', youtube_id: 'E_BuFNpGE_A', uploadDate: '2025-02-16' },
      { title: 'The Archetype of the Alcoholic (Part One)', description: 'Introducing the Archetype of the Alcoholic and its connection to the ancient Trickster/Shaman.', youtube_id: 'GxhOhJ056WQ', uploadDate: '2025-02-03' },
      { title: 'Doorways to the Self', description: 'How the Twelve Steps function as doorways to what Jung called the Self.', youtube_id: '2S3wafhxo0Y', uploadDate: '2025-03-19' },
    ],
  },
  {
    title: 'Emotional Sobriety',
    description: 'Why recovery requires more than spiritual ascent.',
    videos: [
      { title: 'A Case for Coming Down', description: 'The concept of emotional sobriety and the case for descent.', youtube_id: 'sDYXCBCN3KQ', uploadDate: '2025-06-22' },
      { title: 'Monotheism, Misogyny, and Eusebia', description: 'How monotheistic bias shaped recovery. From Corbin and Hillman to the Greek notion of eusebia.', youtube_id: 'kDZG3sBqap4', uploadDate: '2025-08-31' },
    ],
  },
  {
    title: 'Workshops & Collaborations',
    description: 'Friendly Circle Berlin workshops, interviews, and collaborative sessions.',
    videos: [
      { title: 'From Trickster to Shaman (Part 1)', description: 'The intersection of Jungian thought and the history of recovery.', youtube_id: 'h1gzmto1ZLQ', uploadDate: '2024-10-20' },
      { title: 'The Birth of AA: Jung to Bill W. (Part 2)', description: 'From Jung\'s encounter with Rowland Hazard to the founding of Alcoholics Anonymous.', youtube_id: 'jBZ9FhyrgNY', uploadDate: '2024-11-01' },
      { title: 'The Transformative Power of Storytelling (with Bill Schaberg)', description: 'The role of narrative and storytelling in the recovery process.', youtube_id: 'g5lVdXRL-Yc', uploadDate: '2024-12-29' },
      { title: 'Carl Jung, Bill Wilson & AA\'s Spiritual Roots', description: 'Introduction for Ian McCabe\'s presentation on the spiritual foundations of AA.', youtube_id: 'ifWIU05f7UY', uploadDate: '2025-02-01' },
      { title: 'Big Book History #23 (with Bill Schaberg)', description: 'Exploring the narrative traditions embedded in the Big Book.', youtube_id: 'hEXrBZ3qxOk', uploadDate: '2025-01-14' },
    ],
  },
];

const allVideos = series.flatMap(s => s.videos);
const jsonLd = allVideos.map(v => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: v.title,
  description: v.description,
  embedUrl: `https://www.youtube.com/embed/${v.youtube_id}`,
  thumbnailUrl: `https://img.youtube.com/vi/${v.youtube_id}/maxresdefault.jpg`,
  uploadDate: v.uploadDate,
  author: { '@id': 'https://www.cody-peterson.com/#person' },
  publisher: { '@id': 'https://www.cody-peterson.com/#person' },
}));

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.cody-peterson.com/' },
    { '@type': 'ListItem', position: 2, name: 'Videos', item: 'https://www.cody-peterson.com/videos/' },
  ],
};
---
<Base title="Videos" description="Seminars, lectures, and workshops on depth psychology, addiction recovery, and the archetype of the Alcoholic by Cody Peterson." jsonLd={[...jsonLd, breadcrumb]}>

  <div class="page-header">
    <div class="page-header-inner">
      <h1>Videos</h1>
      <p class="subtitle">Seminars, lectures, and workshops on depth psychology, the archetype of the Alcoholic, and Jungian approaches to recovery.</p>
    </div>
  </div>

  {series.map((s, i) => (
    <section class:list={['section', { 'section-alt': i % 2 === 1 }]}>
      <div class="section-inner">
        <div class="section-header">
          <h2>{s.title}</h2>
          <p>{s.description}</p>
        </div>
        <div class="video-grid">
          {s.videos.map(v => (
            <div class="video-card">
              <a href={`https://www.youtube.com/watch?v=${v.youtube_id}`} target="_blank" rel="noopener">
                <img class="video-thumb" src={`https://img.youtube.com/vi/${v.youtube_id}/mqdefault.jpg`} alt={v.title} loading="lazy" width="320" height="180" />
                <div class="video-info">
                  <h3>{v.title}</h3>
                  <p>{v.description}</p>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section" style="text-align: center;">
    <a href="https://www.youtube.com/@cody-peterson-author" target="_blank" rel="noopener" class="btn btn-primary">Watch all on YouTube</a>
  </section>

</Base>
