---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Order received"
  description="Thank you for ordering The Shadow of a Figure of Light."
  noindex
>
  <div class="page-header">
    <div class="page-header-inner">
      <div class="folio">
        <span>The Book &nbsp;·&nbsp; Order</span>
        <em>Confirmed</em>
      </div>
      <h1><em>Order</em> received.</h1>
      <p class="subtitle">Payment confirmed &mdash; thank you.</p>
    </div>
  </div>

  <section class="section">
    <div class="section-inner" style="max-width: 640px;">
      <div class="shop-confirmation">
        <h2 class="confirmation-title">Your signed copy is on its way.</h2>
        <p style="margin-bottom: 0.75rem;">
          I sign and ship every order myself &mdash; your book goes out via USPS Media Mail
          within 2&ndash;3 business days. If you left an inscription request at checkout,
          it&rsquo;ll be in there.
        </p>
        <p class="confirmation-note">
          Stripe has emailed you a receipt. Questions? Reach me at
          <a href="mailto:alkyarchetype@gmail.com">alkyarchetype@gmail.com</a>.
        </p>
      </div>

      <p style="margin-top: 2.5rem;">
        <a href="/videos/" class="btn btn-outline">Watch the lecture series</a>
        &nbsp;&nbsp;
        <a href="https://www.seba.health" class="btn btn-primary">Explore Seba.Health</a>
      </p>
    </div>
  </section>
</Base>
