---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  noSuffix?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = '', seoTitle, noSuffix = false, ogImage, jsonLd, noindex = false } = Astro.props;
const pageTitle = seoTitle || (noSuffix ? title : `${title} | Cody Peterson`);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage || '/images/cody-peterson-bw.jpg';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const navLinks = [
  { href: '/research/', label: 'Research', numeral: 'I' },
  { href: '/book/', label: 'Book', numeral: 'II' },
  { href: '/videos/', label: 'Lectures', numeral: 'III' },
  { href: '/media/', label: 'Media', numeral: 'IV' },
  { href: '/about/', label: 'About', numeral: 'V' },
];

const year = new Date().getFullYear();

const hendersonPlace = {
  '@type': 'Place',
  '@id': 'https://www.cody-peterson.com/#henderson-nv',
  name: 'Henderson, Nevada',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Henderson',
    addressRegion: 'NV',
    addressCountry: 'US',
  },
  containedInPlace: {
    '@type': 'AdministrativeArea',
    name: 'Las Vegas Valley',
  },
};

const lasVegasValleyPlace = {
  '@type': 'AdministrativeArea',
  '@id': 'https://www.cody-peterson.com/#las-vegas-valley',
  name: 'Las Vegas Valley',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'NV',
    addressCountry: 'US',
  },
};

const globalSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    hendersonPlace,
    lasVegasValleyPlace,
    {
      '@type': 'Book',
      author: { '@id': 'https://www.cody-peterson.com/#person' },
      name: 'The Shadow of a Figure of Light: The Archetype of the Alcoholic and the Journey to Enlightenment',
      url: 'https://books.google.com/books/about/The_Shadow_of_a_Figure_of_Light.html?id=sacxEQAAQBAJ',
      publisher: { '@type': 'Organization', name: 'Chiron Publications' },
      datePublished: '2024',
    },
    {
      '@type': 'ScholarlyArticle',
      author: { '@id': 'https://www.cody-peterson.com/#person' },
      name: 'Taming Wild Beasts',
      url: 'https://www.tandfonline.com/doi/full/10.1080/19342039.2025.2487105',
      datePublished: '2025-04-03',
      isPartOf: {
        '@type': 'Periodical',
        name: 'Jung Journal: Culture & Psyche',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.seba.health/#organization',
      name: 'Seba Health', url: 'https://www.seba.health/',
      description: 'Depth-psychology research platform operated on a not-for-profit basis.',
      founder: { '@id': 'https://www.cody-peterson.com/#person' },
    },
    {
      '@type': 'Organization',
      name: 'City Seamless Rain Gutter', url: 'https://www.cityseamless.com/',
      founder: { '@id': 'https://www.cody-peterson.com/#person' },
    },
    {
      '@type': 'Organization',
      name: '702 Alliance', url: 'https://www.702alliance.com/',
      founder: { '@id': 'https://www.cody-peterson.com/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://www.cody-peterson.com/#person',
      name: 'Cody Peterson',
      givenName: 'Cody',
      familyName: 'Peterson',
      url: 'https://www.cody-peterson.com/',
      image: 'https://www.cody-peterson.com/images/cody-peterson-bw.jpg',
      jobTitle: 'Depth psychology researcher and writer',
      description: 'Depth psychology researcher and writer, author of The Shadow of a Figure of Light, designer of AI-assisted research programmes, and founder of Seba.Health.',
      homeLocation: { '@id': 'https://www.cody-peterson.com/#henderson-nv' },
      workLocation: { '@id': 'https://www.cody-peterson.com/#las-vegas-valley' },
      hasOccupation: [
        {
          '@type': 'Occupation',
          name: 'Author',
          occupationalCategory: '27-3043.00',
        },
        {
          '@type': 'Occupation',
          name: 'Depth psychology researcher',
        },
        {
          '@type': 'Occupation',
          name: 'Founder',
        },
      ],
      identifier: [
        { '@type': 'PropertyValue', propertyID: 'ORCID', value: '0009-0009-2028-0154', url: 'https://orcid.org/0009-0009-2028-0154' },
      ],
      sameAs: [
        'https://www.chironpublications.com/product-category/authors/peterson-cody/',
        'https://www.researchgate.net/profile/Cody-Peterson-6/research',
        'https://scholar.google.com/citations?user=a8xhFSgAAAAJ',
        'https://orcid.org/0009-0009-2028-0154',
        'https://www.youtube.com/@cody-peterson-author',
        'https://x.com/AlkyArchetype',
        'https://www.linkedin.com/in/cody-peterson-487224229/',
      ],
      subjectOf: [
        {
          '@type': 'Article',
          name: 'Beyond a Shadow of a Doubt',
          url: 'https://inmag.com/books/shadow-of-a-figure-the-alcoholic-journey-to-enlightenment-cody-peterson.html',
        },
        {
          '@type': 'PodcastEpisode',
          name: 'Cody Peterson on C.G. Jung and Addiction',
          url: 'https://player.fm/series/aeon-byte-gnostic-radio-1335182/cody-peterson-on-cg-jung-and-addiction',
        },
        {
          '@type': 'PodcastEpisode',
          name: 'Addiction and the Journey to Enlightenment',
          url: 'https://bearpsychology.ca/addiction-and-the-journey-to-enlightenment/',
          datePublished: '2026-05-01',
          partOfSeries: {
            '@type': 'PodcastSeries',
            name: 'Bear Psychology Radio Show',
          },
        },
      ],
      memberOf: {
        '@type': 'OrganizationRole',
        roleName: 'Undergraduate psychology student',
        memberOf: { '@type': 'CollegeOrUniversity', name: 'University of Utah', url: 'https://www.utah.edu/' },
      },
      knowsAbout: [
        'Depth psychology', 'Analytical psychology', 'Addiction recovery',
        'Twelve-step programs', 'Homeric philology', 'Emotional sobriety',
        'Archetypal psychology', 'Ancient Greek psychology', 'Thumos',
        'AI-assisted humanities research', 'Corpus analysis', 'Alchemy',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.cody-peterson.com/#website',
      url: 'https://www.cody-peterson.com/',
      name: 'Cody Peterson',
      description: 'Writing, depth psychology, Homeric research, recovery, and research tools by Cody Peterson.',
      publisher: { '@id': 'https://www.cody-peterson.com/#person' },
      inLanguage: 'en-US',
      potentialAction: {
        '@type': 'ReadAction',
        target: ['https://www.cody-peterson.com/research/', 'https://www.cody-peterson.com/book/'],
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL.toString()}#webpage`,
      url: canonicalURL.toString(),
      name: pageTitle,
      description,
      isPartOf: { '@id': 'https://www.cody-peterson.com/#website' },
      about: { '@id': 'https://www.cody-peterson.com/#person' },
      primaryImageOfPage: new URL(ogImageURL, Astro.site).toString(),
      inLanguage: 'en-US',
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.profile-role', '.epigraph-translation', '.section-header h2', '.pull-quote', '.closing-line'],
      },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Cody Peterson" />
  <meta name="theme-color" content="#151b1b" />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Site guide" />
  <link rel="icon" type="image/png" href="/images/moon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL(ogImageURL, Astro.site)} />
  <meta property="og:site_name" content="Cody Peterson" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@AlkyArchetype" />
  <meta name="twitter:creator" content="@AlkyArchetype" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImageURL, Astro.site)} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />
  {jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  <script defer src="https://analytics.seba.health/script.js" data-website-id="01f8f274-971e-431d-a34e-75a84e61dd01"></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-name" aria-label="Cody Peterson — home">
        Cody Peterson<span class="site-name-mark" aria-hidden="true"></span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        {navLinks.map(link => (
          <a href={link.href} class:list={[{ active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
      <div class="header-folio" aria-hidden="true">
        Vol. <em>I</em> &nbsp;·&nbsp; Est. <em>MMXXIV</em>
      </div>
      <button
        type="button"
        class="share-button"
        id="share-page"
        aria-label="Share this page"
        title="Share this page"
        data-share-title={pageTitle}
        data-share-url={canonicalURL.toString()}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="M8.7 10.7 15.3 6.3"></path>
          <path d="M8.7 13.3 15.3 17.7"></path>
        </svg>
        <span class="share-button-label">Share</span>
      </button>
      <span class="share-status" id="share-status" role="status" aria-live="polite"></span>
      <button class="hamburger" id="menu-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
      {navLinks.map(link => (
        <a href={link.href} class:list={[{ active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
          <span class="mobile-numeral" aria-hidden="true">{link.numeral}</span>{link.label}
        </a>
      ))}
    </nav>
  </header>

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <section class="subscribe-section" aria-label="Subscribe to the newsletter">
    <div class="subscribe-inner">
      <div class="subscribe-eyebrow">Correspondence</div>
      <h2>Stay in the work.</h2>
      <p>Depth psychology, recovery, and the ancient roots of feeling. Occasional letters. No spam.</p>
      <form class="subscribe-form" action="https://buttondown.com/api/emails/embed-subscribe/alkyarchetype" method="post">
        <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address" />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <footer class="site-footer">
    <div class="colophon">
      <div class="colophon-block">
        <span class="colophon-label">Colophon</span>
        <em>Cody Peterson</em>
        <p style="color: var(--color-text-muted); font-style: italic; line-height: 1.55; margin: 0;">
          Homeric language, depth psychology, and the history of feeling. Writing and research from the desert.
        </p>
      </div>
      <div class="colophon-block">
        <span class="colophon-label">Work</span>
        <a href="/book/">The Book</a>
        <a href="/research/">Research &amp; publications</a>
        <a href="/videos/">Lectures</a>
        <a href="/media/">Media</a>
        <a href="/about/">About</a>
      </div>
      <div class="colophon-block">
        <span class="colophon-label">Built by Cody</span>
        <a href="https://www.seba.health">Seba Health</a>
        <span>Logoi · Coming soon</span>
        <a href="https://www.702alliance.com">702 Alliance</a>
        <a href="https://www.cityseamless.com">City Seamless</a>
      </div>
      <div class="colophon-block">
        <span class="colophon-label">Correspond</span>
        <a href="mailto:cody@seba.health">cody@seba.health</a>
        <a href="https://x.com/AlkyArchetype" rel="me noopener" target="_blank">X / Twitter</a>
        <a href="https://www.youtube.com/@cody-peterson-author" rel="me noopener" target="_blank">YouTube</a>
        <a href="https://www.linkedin.com/in/cody-peterson-487224229/" rel="me noopener" target="_blank">LinkedIn</a>
        <a href="https://orcid.org/0009-0009-2028-0154" rel="me noopener" target="_blank">ORCID</a>
      </div>
      <div class="colophon-note">
        <span>&copy; {year} Cody Peterson. All rights reserved.</span>
        <span>Composed in the desert. Typeset in Fraunces &amp; Newsreader.</span>
      </div>
    </div>
  </footer>

  <script>
    // Mobile menu
    const toggle = document.getElementById('menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    toggle?.addEventListener('click', () => {
      const isOpen = mobileNav?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
      mobileNav?.setAttribute('aria-hidden', String(!isOpen));
      toggle.classList.toggle('open', isOpen);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileNav?.classList.contains('open')) {
        mobileNav.classList.remove('open');
        mobileNav.setAttribute('aria-hidden', 'true');
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', 'Open navigation menu');
        toggle?.classList.remove('open');
        toggle?.focus();
      }
    });

    // Header scroll shadow
    const header = document.querySelector('.site-header');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    }, { passive: true });

    // Share current page, falling back to copying the canonical URL.
    const shareButton = document.getElementById('share-page');
    const shareStatus = document.getElementById('share-status');
    const shareLabel = shareButton?.querySelector('.share-button-label');
    let shareStatusTimeout;

    function setShareStatus(message) {
      if (!shareButton || !shareStatus) return;
      shareButton.classList.add('is-copied');
      shareStatus.textContent = message;
      if (shareLabel) shareLabel.textContent = message;
      window.clearTimeout(shareStatusTimeout);
      shareStatusTimeout = window.setTimeout(() => {
        shareButton.classList.remove('is-copied');
        shareStatus.textContent = '';
        if (shareLabel) shareLabel.textContent = 'Share';
      }, 2200);
    }

    async function copyShareUrl(url) {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(url);
        return;
      }

      const textArea = document.createElement('textarea');
      textArea.value = url;
      textArea.setAttribute('readonly', '');
      textArea.style.position = 'fixed';
      textArea.style.left = '-9999px';
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      textArea.remove();
    }

    shareButton?.addEventListener('click', async () => {
      const shareUrl = shareButton.dataset.shareUrl || window.location.href;
      const shareTitle = shareButton.dataset.shareTitle || document.title;
      const shareText = document.querySelector('meta[name="description"]')?.getAttribute('content') || '';
      const shareData = { title: shareTitle, text: shareText, url: shareUrl };

      try {
        if (navigator.share && (!navigator.canShare || navigator.canShare(shareData))) {
          await navigator.share(shareData);
          return;
        }

        await copyShareUrl(shareUrl);
        setShareStatus('Copied');
      } catch (error) {
        if (error?.name === 'AbortError') return;
        try {
          await copyShareUrl(shareUrl);
          setShareStatus('Copied');
        } catch (_) {
          setShareStatus('Copy failed');
        }
      }
    });

    // Scroll reveal (progressive enhancement — content visible without JS)
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('.reveal').forEach(el => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight) {
        el.classList.add('revealed');
      } else {
        el.classList.add('reveal-init');
        revealObserver.observe(el);
      }
    });
  </script>
</body>
</html>
