---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  noSuffix?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = '', seoTitle, noSuffix = false, ogImage, jsonLd } = Astro.props;
const pageTitle = seoTitle || (noSuffix ? title : `${title} | Cody Peterson`);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage || '/images/cody-peterson-bw.jpg';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const navLinks = [
  { href: '/book', label: 'Book' },
  { href: '/videos', label: 'Videos' },
  { href: '/media', label: 'Media' },
  { href: '/about', label: 'About' },
];

const globalSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.cody-peterson.com/#person',
      name: 'Cody Peterson',
      url: 'https://www.cody-peterson.com/',
      image: 'https://www.cody-peterson.com/images/cody-peterson-bw.jpg',
      jobTitle: 'Depth Psychology Scholar',
      description: 'Published author (Chiron Publications, 2024), depth psychology scholar, Jung Journal contributor, and founder of Seba.Health.',
      sameAs: [
        'https://www.seba.health/',
        'https://www.chironpublications.com/product-category/authors/peterson-cody/',
        'https://www.tandfonline.com/doi/full/10.1080/19342039.2025.2487105',
        'https://www.researchgate.net/profile/Cody-Peterson-6/research',
        'https://scholar.google.com/citations?user=a8xhFSgAAAAJ',
        'https://orcid.org/0009-0009-2028-0154',
        'https://www.youtube.com/@cody-peterson-author',
        'https://x.com/AlkyArchetype',
        'https://www.linkedin.com/in/cody-peterson-487224229/',
        'https://books.google.com/books/about/The_Shadow_of_a_Figure_of_Light.html?id=sacxEQAAQBAJ',
      ],
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Utah',
        sameAs: 'https://en.wikipedia.org/wiki/University_of_Utah',
      },
      hasCredential: [{
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'Degree',
        educationalLevel: 'Bachelor of Arts in Psychology',
        recognizedBy: {
          '@type': 'CollegeOrUniversity',
          name: 'University of Utah',
          sameAs: 'https://en.wikipedia.org/wiki/University_of_Utah',
        },
      }],
      knowsAbout: [
        'Depth psychology', 'Analytical psychology', 'Addiction recovery',
        'Twelve-step programs', 'Jungian psychotherapy', 'Emotional sobriety',
        'Archetypal psychology', 'Ancient Greek psychology', 'Thumos',
        'Interoception', 'Shamanism', 'Alchemy',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.cody-peterson.com/#website',
      url: 'https://www.cody-peterson.com/',
      name: 'Cody Peterson',
      description: 'Depth psychology scholar, published author, and founder of Seba.Health.',
      publisher: { '@id': 'https://www.cody-peterson.com/#person' },
      inLanguage: 'en-US',
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Cody Peterson" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" type="image/png" href="/images/moon.png" />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL(ogImageURL, Astro.site)} />
  <meta property="og:site_name" content="Cody Peterson" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@AlkyArchetype" />
  <meta name="twitter:creator" content="@AlkyArchetype" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImageURL, Astro.site)} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />
  {jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  <script defer src="https://analytics.seba.health/script.js" data-website-id="01f8f274-971e-431d-a34e-75a84e61dd01"></script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-name">
        <img src="/images/logo-moon.png" alt="" width="32" height="32" style="border-radius: 6px;" aria-hidden="true" />
        Cody Peterson
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        {navLinks.map(link => (
          <a href={link.href} class:list={[{ active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
      <button class="hamburger" id="menu-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
      {navLinks.map(link => (
        <a href={link.href} class:list={[{ active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <section class="subscribe-section">
    <div class="subscribe-inner">
      <h2>Stay in the work.</h2>
      <p>Depth psychology, recovery, and the ancient roots of feeling. No spam, unsubscribe anytime.</p>
      <form class="subscribe-form" action="https://buttondown.com/api/emails/embed-subscribe/alkyarchetype" method="post">
        <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address" />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <footer class="site-footer">
    <p>&copy; 2026 Cody Peterson. Founder, <a href="https://www.seba.health">Seba.Health</a>.</p>
  </footer>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    toggle?.addEventListener('click', () => {
      const isOpen = mobileNav?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      mobileNav?.setAttribute('aria-hidden', String(!isOpen));
      toggle.classList.toggle('open', isOpen);
    });
  </script>
</body>
</html>
