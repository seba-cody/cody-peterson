---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  noSuffix?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = '', seoTitle, noSuffix = false, jsonLd } = Astro.props;
const pageTitle = seoTitle || (noSuffix ? title : `${title} | Cody Peterson`);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const globalSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://cody-peterson.com/#person',
      name: 'Cody Peterson',
      url: 'https://cody-peterson.com/',
      jobTitle: 'Depth Psychology Scholar',
      description: 'Published author (Chiron Publications), depth psychology scholar, Jung Journal contributor, and founder of Seba.Health.',
      sameAs: [
        'https://seba.health/',
        'https://www.chironpublications.com/product-category/authors/peterson-cody/',
        'https://www.tandfonline.com/doi/full/10.1080/19342039.2025.2487105',
        'https://www.researchgate.net/profile/Cody-Peterson-6/research',
        'https://scholar.google.com/citations?user=a8xhFSgAAAAJ',
        'https://orcid.org/0009-0009-2028-0154',
        'https://www.youtube.com/@cody-peterson-author',
        'https://x.com/AlkyArchetype',
        'https://www.linkedin.com/in/cody-peterson-487224229/',
        'https://books.google.com/books/about/The_Shadow_of_a_Figure_of_Light.html?id=sacxEQAAQBAJ',
      ],
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Utah',
        sameAs: 'https://en.wikipedia.org/wiki/University_of_Utah',
      },
      hasCredential: [{
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'Degree',
        educationalLevel: 'Bachelor of Arts in Psychology',
        recognizedBy: {
          '@type': 'CollegeOrUniversity',
          name: 'University of Utah',
          sameAs: 'https://en.wikipedia.org/wiki/University_of_Utah',
        },
      }],
      knowsAbout: [
        'Depth psychology', 'Analytical psychology', 'Addiction recovery',
        'Twelve-step programs', 'Jungian psychotherapy', 'Emotional sobriety',
        'Archetypal psychology',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://cody-peterson.com/#website',
      url: 'https://cody-peterson.com/',
      name: 'Cody Peterson',
      publisher: { '@id': 'https://cody-peterson.com/#person' },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Cody Peterson" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" type="image/png" href="/images/moon.png" />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary" />

  <!-- JSON-LD: Global Person + WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />
  {jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  <script defer src="https://analytics.seba.health/script.js" data-website-id="01f8f274-971e-431d-a34e-75a84e61dd01"></script>
</head>
<body>
  <header style="margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border);">
    <nav style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
      <a href="/" style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--color-text); text-decoration: none;"><img src="/images/moon.png" alt="" width="28" height="28" style="border-radius: 50%;" aria-hidden="true" />Cody Peterson</a>
      <div style="display: flex; gap: 1.5rem;">
        <a href="/book">Book</a>
        <a href="/videos">Videos</a>
        <a href="/media">Media</a>
        <a href="/about">About</a>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
    <div style="max-width: 480px; margin: 0 auto 1.5rem; text-align: center;">
      <p style="font-family: var(--font-heading); font-size: 1.125rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.25rem;">New depth psychology reviews monthly</p>
      <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1rem; line-height: 1.5;">Alchemy, interiority, and the clinical roots of the psyche. No spam, unsubscribe anytime.</p>
      <form action="https://buttondown.com/api/emails/embed-subscribe/alkyarchetype" method="post" style="display: flex; gap: 0.25rem; justify-content: center; flex-wrap: wrap;">
        <input type="email" name="email" placeholder="Your email" required aria-label="Email address" style="flex: 1; min-width: 180px; max-width: 260px; padding: 0.5rem 0.75rem; font-size: 0.9375rem; font-family: var(--font-body); border: 1px solid var(--color-border); border-radius: 4px; background: var(--color-bg); color: var(--color-text); outline: none;" />
        <button type="submit" style="padding: 0.5rem 1.25rem; font-size: 0.9375rem; font-family: var(--font-body); font-weight: 600; color: var(--color-bg); background: var(--color-accent); border: none; border-radius: 4px; cursor: pointer; white-space: nowrap;">Get the reading list</button>
      </form>
    </div>
    <p style="color: var(--color-text-muted); font-size: 0.875rem; text-align: center;">&copy; 2026 Cody Peterson. Founder, <a href="https://seba.health">Seba.Health</a>.</p>
  </footer>
</body>
</html>
