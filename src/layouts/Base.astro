---
import '../styles/global.css';
import { ironThumosSchema } from '../data/iron-thumos';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  noSuffix?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = '', seoTitle, noSuffix = false, ogImage, jsonLd, noindex = false } = Astro.props;
const pageTitle = seoTitle || (noSuffix ? title : `${title} | Cody Peterson`);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage || '/images/life/waterfall-portrait-1200.jpg';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const navLinks = [
  { href: '/research/', label: 'Research' },
  { href: '/book/', label: 'Book' },
  { href: '/videos/', label: 'Talks' },
  { href: '/media/', label: 'Media' },
  { href: '/about/', label: 'About' },
];

const year = new Date().getFullYear();

const hendersonPlace = {
  '@type': 'Place',
  '@id': 'https://www.cody-peterson.com/#henderson-nv',
  name: 'Henderson, Nevada',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Henderson',
    addressRegion: 'NV',
    addressCountry: 'US',
  },
  containedInPlace: {
    '@type': 'AdministrativeArea',
    name: 'Las Vegas Valley',
  },
};

const lasVegasValleyPlace = {
  '@type': 'AdministrativeArea',
  '@id': 'https://www.cody-peterson.com/#las-vegas-valley',
  name: 'Las Vegas Valley',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'NV',
    addressCountry: 'US',
  },
};

const globalSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    ironThumosSchema,
    hendersonPlace,
    lasVegasValleyPlace,
    {
      '@type': 'Book',
      author: { '@id': 'https://www.cody-peterson.com/#person' },
      name: 'The Shadow of a Figure of Light: The Archetype of the Alcoholic and the Journey to Enlightenment',
      url: 'https://books.google.com/books/about/The_Shadow_of_a_Figure_of_Light.html?id=sacxEQAAQBAJ',
      publisher: { '@type': 'Organization', name: 'Chiron Publications' },
      datePublished: '2024',
    },
    {
      '@type': 'ScholarlyArticle',
      author: { '@id': 'https://www.cody-peterson.com/#person' },
      name: 'Taming Wild Beasts',
      url: 'https://www.tandfonline.com/doi/full/10.1080/19342039.2025.2487105',
      datePublished: '2025-04-03',
      isPartOf: {
        '@type': 'Periodical',
        name: 'Jung Journal: Culture & Psyche',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.seba.health/#organization',
      name: 'Seba Health', url: 'https://www.seba.health/',
      description: 'Depth-psychology research platform operated on a not-for-profit basis.',
      founder: { '@id': 'https://www.cody-peterson.com/#person' },
    },
    {
      '@type': 'Organization',
      name: 'City Seamless Rain Gutter', url: 'https://www.cityseamless.com/',
      founder: { '@id': 'https://www.cody-peterson.com/#person' },
    },
    {
      '@type': 'Organization',
      name: '702 Alliance', url: 'https://www.702alliance.com/',
      founder: { '@id': 'https://www.cody-peterson.com/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://www.cody-peterson.com/#person',
      name: 'Cody Peterson',
      givenName: 'Cody',
      familyName: 'Peterson',
      url: 'https://www.cody-peterson.com/',
      image: 'https://www.cody-peterson.com/images/cody-peterson-bw.jpg',
      jobTitle: 'Depth psychology researcher and writer',
      description: 'Depth psychology researcher and writer, author of The Shadow of a Figure of Light, designer of AI-assisted research programmes, and founder of Seba.Health.',
      homeLocation: { '@id': 'https://www.cody-peterson.com/#henderson-nv' },
      workLocation: { '@id': 'https://www.cody-peterson.com/#las-vegas-valley' },
      hasOccupation: [
        {
          '@type': 'Occupation',
          name: 'Author',
          occupationalCategory: '27-3043.00',
        },
        {
          '@type': 'Occupation',
          name: 'Depth psychology researcher',
        },
        {
          '@type': 'Occupation',
          name: 'Founder',
        },
      ],
      identifier: [
        { '@type': 'PropertyValue', propertyID: 'ORCID', value: '0009-0009-2028-0154', url: 'https://orcid.org/0009-0009-2028-0154' },
      ],
      sameAs: [
        'https://www.chironpublications.com/product-category/authors/peterson-cody/',
        'https://www.researchgate.net/profile/Cody-Peterson-6/research',
        'https://scholar.google.com/citations?user=a8xhFSgAAAAJ',
        'https://orcid.org/0009-0009-2028-0154',
        'https://www.youtube.com/@cody-peterson-author',
        'https://x.com/AlkyArchetype',
        'https://www.linkedin.com/in/cody-peterson-487224229/',
      ],
      subjectOf: [
        {
          '@type': 'Article',
          name: 'Beyond a Shadow of a Doubt',
          url: 'https://inmag.com/books/shadow-of-a-figure-the-alcoholic-journey-to-enlightenment-cody-peterson.html',
        },
        {
          '@type': 'PodcastEpisode',
          name: 'Cody Peterson on C.G. Jung and Addiction',
          url: 'https://player.fm/series/aeon-byte-gnostic-radio-1335182/cody-peterson-on-cg-jung-and-addiction',
        },
        {
          '@type': 'PodcastEpisode',
          name: 'Addiction and the Journey to Enlightenment',
          url: 'https://bearpsychology.ca/addiction-and-the-journey-to-enlightenment/',
          datePublished: '2026-05-01',
          partOfSeries: {
            '@type': 'PodcastSeries',
            name: 'Bear Psychology Radio Show',
          },
        },
      ],
      memberOf: {
        '@type': 'OrganizationRole',
        roleName: 'Undergraduate psychology student',
        memberOf: { '@type': 'CollegeOrUniversity', name: 'University of Utah', url: 'https://www.utah.edu/' },
      },
      knowsAbout: [
        'Depth psychology', 'Analytical psychology', 'Addiction recovery',
        'Twelve-step programs', 'Homeric philology', 'Emotional sobriety',
        'Archetypal psychology', 'Ancient Greek psychology', 'Thumos',
        'AI-assisted humanities research', 'Corpus analysis', 'Alchemy',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.cody-peterson.com/#website',
      url: 'https://www.cody-peterson.com/',
      name: 'Cody Peterson',
      description: 'Writing, depth psychology, Homeric research, recovery, and research tools by Cody Peterson.',
      publisher: { '@id': 'https://www.cody-peterson.com/#person' },
      inLanguage: 'en-US',
      potentialAction: {
        '@type': 'ReadAction',
        target: ['https://www.cody-peterson.com/research/', 'https://www.cody-peterson.com/book/'],
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL.toString()}#webpage`,
      url: canonicalURL.toString(),
      name: pageTitle,
      description,
      isPartOf: { '@id': 'https://www.cody-peterson.com/#website' },
      about: { '@id': 'https://www.cody-peterson.com/#person' },
      primaryImageOfPage: new URL(ogImageURL, Astro.site).toString(),
      inLanguage: 'en-US',
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.profile-role', '.epigraph-translation', '.section-header h2', '.pull-quote', '.closing-line'],
      },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Cody Peterson" />
  <meta name="theme-color" content="#0b141d" />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Site guide" />
  <link rel="alternate" type="application/rss+xml" href="/feed.xml" title="Cody Peterson" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400;1,700&family=Noto+Serif+Display:ital,wght@0,300..500;1,300..500&display=swap" rel="stylesheet" />

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL(ogImageURL, Astro.site)} />
  <meta property="og:site_name" content="Cody Peterson" />
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@AlkyArchetype" />
  <meta name="twitter:creator" content="@AlkyArchetype" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImageURL, Astro.site)} />

  <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />
  {jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  <script defer src="https://analytics.seba.health/script.js" data-website-id="01f8f274-971e-431d-a34e-75a84e61dd01"></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-name"><span class="moon" aria-hidden="true"></span>Cody Peterson</a>
      <nav class="site-nav" aria-label="Primary navigation">
        {navLinks.map(link => (
          <a href={link.href} class:list={[{ active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
      {navLinks.map(link => (
        <a href={link.href} class:list={[{ active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
  </header>

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <section class="letters" aria-label="Occasional letters by email">
    <div class="column">
      <h2>Letters</h2>
      <p>Now and then I send an email about what I am writing. Leave your address if you want one.</p>
      <form class="letters-form" action="https://buttondown.com/api/emails/embed-subscribe/alkyarchetype" method="post">
        <label for="letters-email" class="visually-hidden">Email address</label>
        <input id="letters-email" type="email" name="email" placeholder="you@example.com" required />
        <button type="submit">Send me the letters</button>
      </form>
    </div>
  </section>

  <footer class="site-footer">
    <div class="column">
      <p class="footer-mark"><span class="moon" aria-hidden="true"></span>Cody Peterson</p>
      <div class="footer-lists">
        <ul class="footer-links">
          <li><a href="https://www.seba.health">Seba.Health</a></li>
          <li>Logoi, coming soon</li>
          <li><a href="https://www.cityseamless.com">City Seamless</a></li>
          <li><a href="https://www.702alliance.com">702 Alliance</a></li>
        </ul>
        <ul class="footer-links">
          <li><a href="https://x.com/AlkyArchetype" rel="me noopener" target="_blank">X</a></li>
          <li><a href="https://www.youtube.com/@cody-peterson-author" rel="me noopener" target="_blank">YouTube</a></li>
          <li><a href="https://www.linkedin.com/in/cody-peterson-487224229/" rel="me noopener" target="_blank">LinkedIn</a></li>
          <li><a href="https://orcid.org/0009-0009-2028-0154" rel="me noopener" target="_blank">ORCID</a></li>
          <li><a href="/feed.xml" type="application/rss+xml">RSS feed</a></li>
          <li><a href="mailto:cody@seba.health">cody@seba.health</a></li>
        </ul>
        <p class="muted">© {year} Cody Peterson</p>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    function setMenu(open) {
      mobileNav?.classList.toggle('open', open);
      mobileNav?.setAttribute('aria-hidden', String(!open));
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (toggle) toggle.textContent = open ? 'Close' : 'Menu';
    }
    toggle?.addEventListener('click', () => setMenu(!mobileNav?.classList.contains('open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNav?.classList.contains('open')) { setMenu(false); toggle?.focus(); }
    });
  </script>
</body>
</html>
